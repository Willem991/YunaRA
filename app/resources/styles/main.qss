

#main_window{

}

#menu{
    background-color:rgba(27, 26, 32, 1);
}

#central_widget{
    background-color:rgba(27, 26, 32, 1);
}

#nav_bar{
    background-color:rgba(22, 21, 27, 1);
    border-radius:2px;
}

/* =========================
   Library Elements
   ========================= */

QScrollArea{
    background-color:rgba(11, 11, 11, 1);
}

#library{
    background-color:rgba(11, 11, 11, 1);
    border-radius:2px;
    border-width:0px;
}

/* =========================
   ADD BOOK CARD
   ========================= */

#add_book_card {
    background-color: #252a30;   

    border: none;
    border-radius: 12px;

    padding: 12px;
    margin: 20px;
}

#add_book_card:hover {
    background-color: #2b3138;
}

#library_card{
    margin: 20px;
}

#library_card QLabel {
    margin: 20px;
}
